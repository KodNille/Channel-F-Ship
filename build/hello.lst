      0  2000 ????				      include	"ves.h"
      1  2000 ????						; VES.H
      2  2000 ????						; Fairchild Channel F Header
      3  2000 ????						; Version 1.01, 2/NOVEMBER/2004
      4  2000 ????
      5  2000 ????	       00 65	   VERSION_CHANNELF =	101
      6  2000 ????	       00 65	   VERSION_VES =	101
      7  2000 ????
      8  2000 ????						; THIS IS A PRELIMINARY RELEASE OF *THE* "STANDARD" VES.H
      9  2000 ????						; THIS FILE IS EXPLICITLY SUPPORTED AS A DASM-PREFERRED COMPANION FILE
     10  2000 ????						; PLEASE DO *NOT* REDISTRIBUTE THIS FILE!
     11  2000 ????						;
     12  2000 ????						; This file defines hardware registers and memory mapping for the
     13  2000 ????						; Fairchild Channel-F. It is distributed as a companion machine-specific support package
     14  2000 ????						; for the DASM compiler. Updates to this file, DASM, and associated tools are
     15  2000 ????						; available at at http://www.atari2600.org/dasm
     16  2000 ????						;
     17  2000 ????						; Many thanks to the original author(s) of this file, and to everyone who has
     18  2000 ????						; contributed to understanding the Channel-F.	If you take issue with the
     19  2000 ????						; contents, or naming of registers, please write to me (atari2600@taswegian.com)
     20  2000 ????						; with your views.  Please contribute, if you think you can improve this
     21  2000 ????						; file!
     22  2000 ????						;
     23  2000 ????						; Latest Revisions...
     24  2000 ????						; 1.01   2/NOV/2004	Kevin Lipe's version (combined macro/header)
     25  2000 ????						;			renamed to VES.H
     26  2000 ????						;			alternates provided for deprecated equates
     27  2000 ????						;			ALL hardware/BIOS equates now in uppercase and prefixed
     28  2000 ????						; 1.00  31/OCT/2004	- initial release
     29  2000 ????
     30  2000 ????
     31  2000 ????
     32  2000 ????						; Please contribute Channel-F header code to atari2600@taswegian.com
     33  2000 ????
     34  2000 ????
     35  2000 ????
     36  2000 ????			   INCLUDE_DEPRECATED		; remove to DISABLE deprecated equates
     37  2000 ????
     38  2000 ????
     39  2000 ????						;-------------------------------------------------------------------------------
     40  2000 ????						; BIOS Calls
     41  2000 ????						;------------------------
     42  2000 ????
     43  2000 ????	       00 d0	   BIOS_CLEAR_SCREEN =	$00d0	; uses r31
     44  2000 ????	       00 8f	   BIOS_DELAY =	$008f
     45  2000 ????	       01 07	   BIOS_PUSH_K =	$0107	; used to allow more subroutine stack space
     46  2000 ????	       01 1e	   BIOS_POP_K =	$011e
     47  2000 ????	       06 79	   BIOS_DRAW_CHARACTER =	$0679
     48  2000 ????
     49  2000 ????						;-------------------------------------------------------------------------------
     50  2000 ????						; Colors
     51  2000 ????
     52  2000 ????	       00 40	   COLOR_RED  =	$40
     53  2000 ????	       00 80	   COLOR_BLUE =	$80
     54  2000 ????	       00 00	   COLOR_GREEN =	$00
     55  2000 ????	       00 c0	   COLOR_BACKGROUND =	$C0
     56  2000 ????
     57  2000 ????						; BAckground Colors
     58  2000 ????
     59  2000 ????	       00 d6	   BK_COLOR_GREY =	$d6
     60  2000 ????	       00 93	   BK_COLOR_BLUE =	$93
     61  2000 ????	       00 c0	   BK_COLOR_GREEN =	$c0
     62  2000 ????	       00 21	   BK_COLOR_BLACK =	$21
     63  2000 ????
     64  2000 ????						; Alternate (European) spellings...
     65  2000 ????
     66  2000 ????	       00 40	   COLOUR_RES =	COLOR_RED
     67  2000 ????	       00 80	   COLOUR_BLUE =	COLOR_BLUE
     68  2000 ????	       00 00	   COLOUR_GREEN =	COLOR_GREEN
     69  2000 ????	       00 c0	   COLOUR_BACKGROUND =	COLOR_BACKGROUND
     70  2000 ????
     71  2000 ????						;-------------------------------------------------------------------------------
     72  2000 ????						; DEPRECATED equates.
     73  2000 ????						; These present to be compatible with existing equate usage.  
     74  2000 ????						; DO NOT USE THESE IN NEW CODE -- WE WANT TO GET RID OF THEM!
     75  2000 ????
     76  2000 ????			  -	      IFCONST	INCLUDE_DEPRECATED
     77  2000 ????			  -
     78  2000 ????			  -clrscrn    =	BIOS_CLEAR_SCREEN	; DEPRECATED!
     79  2000 ????			  -delay      =	BIOS_DELAY	; DEPRECATED!
     80  2000 ????			  -pushk      =	BIOS_PUSH_K	; DEPRECATED!
     81  2000 ????			  -popk       =	BIOS_POP_K	; DEPRECATED!
     82  2000 ????			  -drawchar   =	BIOS_DRAW_CHARACTER	; DEPRECATED!
     83  2000 ????			  -
     84  2000 ????			  -red	      =	COLOR_RED	; DEPRECATED!
     85  2000 ????			  -blue       =	COLOR_BLUE	; DEPRECATED
     86  2000 ????			  -green      =	COLOR_GREEN	; DEPRECATED
     87  2000 ????			  -bkg	      =	COLOR_BACKGROUND	; DEPRECATED
     88  2000 ????			  -
     89  2000 ????				      ENDIF
     90  2000 ????
     91  2000 ????						;------------------------
     92  2000 ????						; Schach RAM
     93  2000 ????						;------------------------
     94  2000 ????	       28 00	   ram	      =	$2800	;location of RAM available in Schach cartridge
     95  2000 ????
     96  2000 ????						;===================================================================
     97  2000 ????						; M A C R O S
     98  2000 ????						;===================================================================
     99  2000 ????
    100  2000 ????						;-------------------------
    101  2000 ????						; CARTRIDGE_START
    102  2000 ????						; Original Author: Sean Riddle
    103  2000 ????						; Inserts the $55 that signals a valid Channel F cartridge and an
    104  2000 ????						; unused byte, which places the VES at the cartridge entry point, $802.
    105  2000 ????
    106  2000 ????				      MAC	cartridge_start
    107  2000 ????				      .byte	$55, $00	; valid cart indicator, unused byte
    108  2000 ????				      ENDM
    109  2000 ????
    110  2000 ????						;-------------------------
    111  2000 ????						; CARTRIDGE_INIT
    112  2000 ????						; Original Author: Sean Riddle
    113  2000 ????						; Initalizes the hardware and clears the complement flag.
    114  2000 ????
    115  2000 ????				      MAC	cartridge_init
    116  2000 ????						; initalize the hardware
    117  2000 ????				      lis	0
    118  2000 ????				      outs	1
    119  2000 ????				      outs	4
    120  2000 ????				      outs	5
    121  2000 ????				      outs	0
    122  2000 ????
    123  2000 ????						; clear the complement flag (r32)
    124  2000 ????				      lisu	4
    125  2000 ????				      lisl	0
    126  2000 ????				      lr	S, A
    127  2000 ????				      ENDM
    128  2000 ????
    129  2000 ????						;-------------------------
    130  2000 ????						; PROMPTS_NO_T
    131  2000 ????						; Original Author: Sean Riddle
    132  2000 ????						; This code functions the same as the "prompts" section of the BIOS,
    133  2000 ????						; but this code doesn't have a "T?" prompt, so it's useful in games that
    134  2000 ????						; don't have time limits or settings.
    135  2000 ????
    136  2000 ????				      MAC	prompts_not
    137  2000 ????			   prompts    SUBROUTINE
    138  2000 ????				      LR	K,P	; 
    139  2000 ????				      PI	pushk	; 
    140  2000 ????			   .prompts2  LI	$85	; red 5 (S)
    141  2000 ????				      LR	$0,A	; 
    142  2000 ????				      PI	prompt	; 
    143  2000 ????				      LR	A,$4	; 
    144  2000 ????				      CI	$08	; is it button 4, Start?
    145  2000 ????				      BF	$4,.notbut4	; no, check others
    146  2000 ????			   .notbut2
    147  2000 ????				      PI	popk	; yes, return
    148  2000 ????				      PK		; 
    149  2000 ????
    150  2000 ????			   .notbut4   CI	$02	; is it button 2, Mode?
    151  2000 ????				      BF	$4,.notbut2	; 
    152  2000 ????				      LI	$8e	; red M
    153  2000 ????				      LR	$0,A	; 
    154  2000 ????				      PI	prompt	; 
    155  2000 ????				      LISU	3	; 
    156  2000 ????				      LISL	6	; 
    157  2000 ????				      LR	A,(IS)	; 
    158  2000 ????				      as	4	;add the mode to the game #
    159  2000 ????				      LR	(IS),A	; 
    160  2000 ????				      BF	$0,.prompts2	; 
    161  2000 ????				      ENDM
    162  2000 ????
    163  2000 ????						;-------------------------
    164  2000 ????						; SETISAR
    165  2000 ????						; Original Author: Blackbird
    166  2000 ????						; Sets the ISAR to a register number, using lisu and lisl
    167  2000 ????
    168  2000 ????				      MAC	setisar
    169  2000 ????				      lisu	[[{1}] >> 3]
    170  2000 ????				      lisl	[[{1}] & %111]
    171  2000 ????				      ENDM
    172  2000 ????						;-------------------------------------------------------------------------------
    173  2000 ????						; The following required for back-compatibility with code which does not use
    174  2000 ????						; segments.
    175  2000 ????
    176  2000 ????				      SEG
    177  2000 ????
    178  2000 ????						; EOF
