      0  0000 ????				      include	"ves.h"
      1  0000 ????						; VES.H
      2  0000 ????						; Fairchild Channel F Header
      3  0000 ????						; Version 1.01, 2/NOVEMBER/2004
      4  0000 ????
      5  0000 ????	       00 65	   VERSION_CHANNELF =	101
      6  0000 ????	       00 65	   VERSION_VES =	101
      7  0000 ????
      8  0000 ????						; THIS IS A PRELIMINARY RELEASE OF *THE* "STANDARD" VES.H
      9  0000 ????						; THIS FILE IS EXPLICITLY SUPPORTED AS A DASM-PREFERRED COMPANION FILE
     10  0000 ????						; PLEASE DO *NOT* REDISTRIBUTE THIS FILE!
     11  0000 ????						;
     12  0000 ????						; This file defines hardware registers and memory mapping for the
     13  0000 ????						; Fairchild Channel-F. It is distributed as a companion machine-specific support package
     14  0000 ????						; for the DASM compiler. Updates to this file, DASM, and associated tools are
     15  0000 ????						; available at at http://www.atari2600.org/dasm
     16  0000 ????						;
     17  0000 ????						; Many thanks to the original author(s) of this file, and to everyone who has
     18  0000 ????						; contributed to understanding the Channel-F.	If you take issue with the
     19  0000 ????						; contents, or naming of registers, please write to me (atari2600@taswegian.com)
     20  0000 ????						; with your views.  Please contribute, if you think you can improve this
     21  0000 ????						; file!
     22  0000 ????						;
     23  0000 ????						; Latest Revisions...
     24  0000 ????						; 1.01   2/NOV/2004	Kevin Lipe's version (combined macro/header)
     25  0000 ????						;			renamed to VES.H
     26  0000 ????						;			alternates provided for deprecated equates
     27  0000 ????						;			ALL hardware/BIOS equates now in uppercase and prefixed
     28  0000 ????						; 1.00  31/OCT/2004	- initial release
     29  0000 ????
     30  0000 ????
     31  0000 ????
     32  0000 ????						; Please contribute Channel-F header code to atari2600@taswegian.com
     33  0000 ????
     34  0000 ????
     35  0000 ????
     36  0000 ????			   INCLUDE_DEPRECATED		; remove to DISABLE deprecated equates
     37  0000 ????
     38  0000 ????
     39  0000 ????						;-------------------------------------------------------------------------------
     40  0000 ????						; BIOS Calls
     41  0000 ????						;------------------------
     42  0000 ????
     43  0000 ????	       00 d0	   BIOS_CLEAR_SCREEN =	$00d0	; uses r31
     44  0000 ????	       00 8f	   BIOS_DELAY =	$008f
     45  0000 ????	       01 07	   BIOS_PUSH_K =	$0107	; used to allow more subroutine stack space
     46  0000 ????	       01 1e	   BIOS_POP_K =	$011e
     47  0000 ????	       06 79	   BIOS_DRAW_CHARACTER =	$0679
     48  0000 ????
     49  0000 ????						;-------------------------------------------------------------------------------
     50  0000 ????						; Colors
     51  0000 ????
     52  0000 ????	       00 40	   COLOR_RED  =	$40
     53  0000 ????	       00 80	   COLOR_BLUE =	$80
     54  0000 ????	       00 00	   COLOR_GREEN =	$00
     55  0000 ????	       00 c0	   COLOR_BACKGROUND =	$C0
     56  0000 ????
     57  0000 ????						; BAckground Colors
     58  0000 ????
     59  0000 ????	       00 d6	   BK_COLOR_GREY =	$d6
     60  0000 ????	       00 93	   BK_COLOR_BLUE =	$93
     61  0000 ????	       00 c0	   BK_COLOR_GREEN =	$c0
     62  0000 ????	       00 21	   BK_COLOR_BLACK =	$21
     63  0000 ????
     64  0000 ????						; Alternate (European) spellings...
     65  0000 ????
     66  0000 ????	       00 40	   COLOUR_RES =	COLOR_RED
     67  0000 ????	       00 80	   COLOUR_BLUE =	COLOR_BLUE
     68  0000 ????	       00 00	   COLOUR_GREEN =	COLOR_GREEN
     69  0000 ????	       00 c0	   COLOUR_BACKGROUND =	COLOR_BACKGROUND
     70  0000 ????
