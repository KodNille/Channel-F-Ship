     67  0000 ????	       00 80	   COLOUR_BLUE =	COLOR_BLUE
     68  0000 ????	       00 00	   COLOUR_GREEN =	COLOR_GREEN
     69  0000 ????	       00 c0	   COLOUR_BACKGROUND =	COLOR_BACKGROUND
