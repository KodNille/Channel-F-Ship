      0  0000 ????				      include	"ves.h"
      1  0000 ????						; VES.H
      2  0000 ????						; Fairchild Channel F Header
      3  0000 ????						; Version 1.01, 2/NOVEMBER/2004
      4  0000 ????
      5  0000 ????	       00 65	   VERSION_CHANNELF =	101
      6  0000 ????	       00 65	   VERSION_VES =	101
      7  0000 ????
      8  0000 ????						; THIS IS A PRELIMINARY RELEASE OF *THE* "STANDARD" VES.H
      9  0000 ????						; THIS FILE IS EXPLICITLY SUPPORTED AS A DASM-PREFERRED COMPANION FILE
     10  0000 ????						; PLEASE DO *NOT* REDISTRIBUTE THIS FILE!
     11  0000 ????						;
     12  0000 ????						; This file defines hardware registers and memory mapping for the
     13  0000 ????						; Fairchild Channel-F. It is distributed as a companion machine-specific support package
     14  0000 ????						; for the DASM compiler. Updates to this file, DASM, and associated tools are
     15  0000 ????						; available at at http://www.atari2600.org/dasm
     16  0000 ????						;
     17  0000 ????						; Many thanks to the original author(s) of this file, and to everyone who has
     18  0000 ????						; contributed to understanding the Channel-F.	If you take issue with the
     19  0000 ????						; contents, or naming of registers, please write to me (atari2600@taswegian.com)
     20  0000 ????						; with your views.  Please contribute, if you think you can improve this
     21  0000 ????						; file!
     22  0000 ????						;
     23  0000 ????						; Latest Revisions...
     24  0000 ????						; 1.01   2/NOV/2004	Kevin Lipe's version (combined macro/header)
     25  0000 ????						;			renamed to VES.H
     26  0000 ????						;			alternates provided for deprecated equates
     27  0000 ????						;			ALL hardware/BIOS equates now in uppercase and prefixed
     28  0000 ????						; 1.00  31/OCT/2004	- initial release
     29  0000 ????
     30  0000 ????
     31  0000 ????
     32  0000 ????						; Please contribute Channel-F header code to atari2600@taswegian.com
     33  0000 ????
     34  0000 ????
     35  0000 ????
     36  0000 ????			   INCLUDE_DEPRECATED		; remove to DISABLE deprecated equates
     37  0000 ????
     38  0000 ????
     39  0000 ????						;-------------------------------------------------------------------------------
     40  0000 ????						; BIOS Calls
     41  0000 ????						;------------------------
     42  0000 ????
     43  0000 ????	       00 d0	   BIOS_CLEAR_SCREEN =	$00d0	; uses r31
     44  0000 ????	       00 8f	   BIOS_DELAY =	$008f
     45  0000 ????	       01 07	   BIOS_PUSH_K =	$0107	; used to allow more subroutine stack space
     46  0000 ????	       01 1e	   BIOS_POP_K =	$011e
     47  0000 ????	       06 79	   BIOS_DRAW_CHARACTER =	$0679
     48  0000 ????
     49  0000 ????						;-------------------------------------------------------------------------------
     50  0000 ????						; Colors
     51  0000 ????
     52  0000 ????	       00 40	   COLOR_RED  =	$40
     53  0000 ????	       00 80	   COLOR_BLUE =	$80
     54  0000 ????	       00 00	   COLOR_GREEN =	$00
     55  0000 ????	       00 c0	   COLOR_BACKGROUND =	$C0
     56  0000 ????
     57  0000 ????						; BAckground Colors
     58  0000 ????
     59  0000 ????	       00 d6	   BK_COLOR_GREY =	$d6
     60  0000 ????	       00 93	   BK_COLOR_BLUE =	$93
     61  0000 ????	       00 c0	   BK_COLOR_GREEN =	$c0
     62  0000 ????	       00 21	   BK_COLOR_BLACK =	$21
     63  0000 ????
     64  0000 ????						; Alternate (European) spellings...
     65  0000 ????
     66  0000 ????	       00 40	   COLOUR_RES =	COLOR_RED
     67  0000 ????	       00 80	   COLOUR_BLUE =	COLOR_BLUE
     68  0000 ????	       00 00	   COLOUR_GREEN =	COLOR_GREEN
     69  0000 ????	       00 c0	   COLOUR_BACKGROUND =	COLOR_BACKGROUND
     70  0000 ????
     71  0000 ????						;-------------------------------------------------------------------------------
     72  0000 ????						; DEPRECATED equates.
     73  0000 ????						; These present to be compatible with existing equate usage.  
     74  0000 ????						; DO NOT USE THESE IN NEW CODE -- WE WANT TO GET RID OF THEM!
     75  0000 ????
     76  0000 ????			  -	      IFCONST	INCLUDE_DEPRECATED
     77  0000 ????			  -
     78  0000 ????			  -clrscrn    =	BIOS_CLEAR_SCREEN	; DEPRECATED!
     79  0000 ????			  -delay      =	BIOS_DELAY	; DEPRECATED!
     80  0000 ????			  -pushk      =	BIOS_PUSH_K	; DEPRECATED!
     81  0000 ????			  -popk       =	BIOS_POP_K	; DEPRECATED!
     82  0000 ????			  -drawchar   =	BIOS_DRAW_CHARACTER	; DEPRECATED!
     83  0000 ????			  -
     84  0000 ????			  -red	      =	COLOR_RED	; DEPRECATED!
     85  0000 ????			  -blue       =	COLOR_BLUE	; DEPRECATED
     86  0000 ????			  -green      =	COLOR_GREEN	; DEPRECATED
     87  0000 ????			  -bkg	      =	COLOR_BACKGROUND	; DEPRECATED
     88  0000 ????			  -
     89  0000 ????				      ENDIF
     90  0000 ????
     91  0000 ????						;------------------------
     92  0000 ????						; Schach RAM
     93  0000 ????						;------------------------
     94  0000 ????	       28 00	   ram	      =	$2800	;location of RAM available in Schach cartridge
     95  0000 ????
     96  0000 ????						;===================================================================
     97  0000 ????						; M A C R O S
     98  0000 ????						;===================================================================
     99  0000 ????
    100  0000 ????						;-------------------------
    101  0000 ????						; CARTRIDGE_START
    102  0000 ????						; Original Author: Sean Riddle
    103  0000 ????						; Inserts the $55 that signals a valid Channel F cartridge and an
    104  0000 ????						; unused byte, which places the VES at the cartridge entry point, $802.
    105  0000 ????
    106  0000 ????				      MAC	cartridge_start
    107  0000 ????				      .byte	$55, $00	; valid cart indicator, unused byte
    108  0000 ????				      ENDM
    109  0000 ????
    110  0000 ????						;-------------------------
    111  0000 ????						; CARTRIDGE_INIT
    112  0000 ????						; Original Author: Sean Riddle
    113  0000 ????						; Initalizes the hardware and clears the complement flag.
    114  0000 ????
    115  0000 ????				      MAC	cartridge_init
    116  0000 ????						; initalize the hardware
    117  0000 ????				      lis	0
    118  0000 ????				      outs	1
    119  0000 ????				      outs	4
    120  0000 ????				      outs	5
    121  0000 ????				      outs	0
    122  0000 ????
    123  0000 ????						; clear the complement flag (r32)
    124  0000 ????				      lisu	4
    125  0000 ????				      lisl	0
    126  0000 ????				      lr	S, A
    127  0000 ????				      ENDM
    128  0000 ????
    129  0000 ????						;-------------------------
    130  0000 ????						; PROMPTS_NO_T
    131  0000 ????						; Original Author: Sean Riddle
    132  0000 ????						; This code functions the same as the "prompts" section of the BIOS,
    133  0000 ????						; but this code doesn't have a "T?" prompt, so it's useful in games that
    134  0000 ????						; don't have time limits or settings.
    135  0000 ????
    136  0000 ????				      MAC	prompts_not
    137  0000 ????			   prompts    SUBROUTINE
    138  0000 ????				      LR	K,P	; 
    139  0000 ????				      PI	pushk	; 
    140  0000 ????			   .prompts2  LI	$85	; red 5 (S)
    141  0000 ????				      LR	$0,A	; 
    142  0000 ????				      PI	prompt	; 
    143  0000 ????				      LR	A,$4	; 
    144  0000 ????				      CI	$08	; is it button 4, Start?
    145  0000 ????				      BF	$4,.notbut4	; no, check others
    146  0000 ????			   .notbut2
    147  0000 ????				      PI	popk	; yes, return
    148  0000 ????				      PK		; 
    149  0000 ????
    150  0000 ????			   .notbut4   CI	$02	; is it button 2, Mode?
    151  0000 ????				      BF	$4,.notbut2	; 
    152  0000 ????				      LI	$8e	; red M
    153  0000 ????				      LR	$0,A	; 
    154  0000 ????				      PI	prompt	; 
    155  0000 ????				      LISU	3	; 
    156  0000 ????				      LISL	6	; 
    157  0000 ????				      LR	A,(IS)	; 
    158  0000 ????				      as	4	;add the mode to the game #
    159  0000 ????				      LR	(IS),A	; 
    160  0000 ????				      BF	$0,.prompts2	; 
    161  0000 ????				      ENDM
    162  0000 ????
    163  0000 ????						;-------------------------
    164  0000 ????						; SETISAR
    165  0000 ????						; Original Author: Blackbird
    166  0000 ????						; Sets the ISAR to a register number, using lisu and lisl
    167  0000 ????
    168  0000 ????				      MAC	setisar
    169  0000 ????				      lisu	[[{1}] >> 3]
    170  0000 ????				      lisl	[[{1}] & %111]
    171  0000 ????				      ENDM
    172  0000 ????						;-------------------------------------------------------------------------------
    173  0000 ????						; The following required for back-compatibility with code which does not use
    174  0000 ????						; segments.
    175  0000 ????
    176  0000 ????				      SEG
    177  0000 ????
    178  0000 ????						; EOF
